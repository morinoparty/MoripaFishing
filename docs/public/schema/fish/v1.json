{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishing.plugin.morino.party/schema/fish/v1.json",
  "title": "MoripaFishing Fish Definition",
  "description": "MoripaFishing における魚 (fish/**/*.json) の定義スキーマ (v1)。未知のキーは読み込み時にエラーになります。",
  "type": "object",
  "required": ["id", "rarity", "displayName", "item", "size"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema への URL 参照。エディタでの補完・検証に使用され、読み込み時には無視されます。"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "魚を一意に識別する ID (例: \"tuna\")。"
    },
    "rarity": {
      "type": "string",
      "minLength": 1,
      "description": "登録済みのレアリティの ID (例: \"common\")。"
    },
    "displayName": {
      "type": "object",
      "description": "ロケールごとの表示名 (MiniMessage)。キーはロケールコード (例: \"en_US\", \"ja_JP\") を使用します。",
      "additionalProperties": { "type": "string" }
    },
    "lore": {
      "type": "object",
      "default": {},
      "description": "ロケールごとの説明文 (MiniMessage)。<rarity> <size> <angler> <world> <timestamp> を使えます。",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "item": {
      "$ref": "#/$defs/FishItem"
    },
    "size": {
      "$ref": "#/$defs/FishSize"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "default": 1.0,
      "description": "同一レアリティ内での重み付け抽選に使用される値。0 の魚は抽選されません。"
    },
    "worth": {
      "type": ["string", "null"],
      "default": null,
      "description": "価値の計算式 (exp4j)。変数 length_rate を使えます。null の場合はレアリティ側の式が使用されます。"
    },
    "conditions": {
      "$ref": "#/$defs/FishConditions"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "false の場合、この魚は抽選から除外されます。期間限定魚などに使用します。"
    }
  },
  "$defs": {
    "WeatherType": {
      "type": "string",
      "enum": ["SUNNY", "CLOUDY", "RAINY", "THUNDERSTORM", "SNOWY", "FOGGY"],
      "description": "天候の種類。"
    },
    "FishConditions": {
      "type": "object",
      "additionalProperties": false,
      "description": "魚が出現するための条件。省略または空の配列は「制限なし」を意味します。",
      "properties": {
        "weather": {
          "type": "array",
          "items": { "$ref": "#/$defs/WeatherType" },
          "uniqueItems": true,
          "default": []
        },
        "world": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": [],
          "description": "対象となる釣りワールド ID の一覧。"
        }
      }
    },
    "FishSize": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "description": "最小サイズ (cm)。max より小さい必要があります。"
        },
        "max": {
          "type": "number",
          "description": "最大サイズ (cm)。"
        }
      }
    },
    "FishItem": {
      "type": "object",
      "required": ["material"],
      "additionalProperties": false,
      "properties": {
        "material": {
          "type": "string",
          "minLength": 1,
          "description": "アイテムとして使える Bukkit Material の名前 (例: \"COD\", \"PLAYER_HEAD\")。"
        },
        "customModelData": {
          "type": "array",
          "items": { "type": "number" },
          "default": [],
          "description": "リソースパック用のカスタムモデルデータ (float) 値。"
        },
        "skullTexture": {
          "type": ["string", "null"],
          "default": null,
          "description": "PLAYER_HEAD に適用するテクスチャ (Base64 エンコード)。"
        }
      }
    }
  }
}

        "versionModifier": "(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)"
      },
      "beta": {
        "useUpstreamLabel": true
      }
    }
  ],
  "softDependencies": [
    "MoripaFishing-Integration-WorldLifecycle",
    "MoripaFishing-Integration-Weather"
  ]
}
